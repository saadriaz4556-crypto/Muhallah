rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Explicitly allow ANYONE to read/write/update 'users' collection
    // This is required for "Forgot Password" flow since the user is not logged in.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: Deny other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
