rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Explicitly allow ANYONE to read/write/update 'users' collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Jobs Collection Rules
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.posterId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.posterId == request.auth.uid;
    }

    // Job Applications Collection Rules
    match /job_applications/{applicationId} {
      allow create: if request.auth != null && request.resource.data.applicantId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.applicantId == request.auth.uid || 
        get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.posterId == request.auth.uid
      );
      allow update: if request.auth != null && get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.posterId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.applicantId == request.auth.uid;
    }

    // Panic Alerts Collection Rules
    match /panic_alerts/{alertId} {
      // Any authenticated user can create a panic alert
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.resolvedAt == null;

      // Authenticated users can read alerts (Firestore query filters by mohallahId)
      allow read: if request.auth != null;

      // Only the original creator can update (e.g., mark as resolved)
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      // No one can delete panic alerts (audit trail)
      allow delete: if false;
    }

    // Default: Deny other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
