rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only allow an authenticated user to read/write files in their own folder
    match /users/{userId}/{allPaths=**} {
      // Allow read/write only if the authenticated user's ID matches the {userId} in the path
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Job Applications CV Rules
    match /job_applications/{jobId}/{applicantId}/{fileName} {
      // Only applicant can upload CV (must be PDF, max 5MB)
      allow write: if request.auth != null 
                   && request.auth.uid == applicantId 
                   && request.resource.size < 5 * 1024 * 1024 
                   && request.resource.contentType.matches('application/pdf');
      
      // Applicant can read their own CV, Job poster can read CVs for their job
      allow read: if request.auth != null && (
        request.auth.uid == applicantId ||
        firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.posterId == request.auth.uid
      );
    }
  }
}
