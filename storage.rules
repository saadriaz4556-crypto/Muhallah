rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only allow an authenticated user to read/write files in their own folder
    match /users/{userId}/{allPaths=**} {
      // Allow read/write only if the authenticated user's ID matches the {userId} in the path
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
